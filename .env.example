# Copy this file to `.env` and fill in values. `.env` is gitignored.

# Provider selection. Independent for LLM (text-only planning)
# and Vision (screen classification / VLM calls).
# Allowed values: stub | ollama | openai_compat
#   stub          — dev mode, canned answers, no external dependencies
#   ollama        — local, via the Ollama daemon
#   openai_compat — cloud or self-hosted, via any OpenAI-compatible API
LLM_PROVIDER=stub
VISION_PROVIDER=stub

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_VISION_MODEL=qwen2-vl:2b

# --- OpenAI-compatible (cloud or self-hosted) ---
# Works with OpenAI, Groq, Together, OpenRouter, llama.cpp server, vLLM, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Account-specific defaults for the standalone tools/ scripts ---
# All optional: the live game VM is the authoritative source. These only provide a
# fixed fallback so a caller can skip the live lookup / a positional CLI arg.
# Your home/world server id (e.g. attack, gather, solo-attack default target server).
LW_DEFAULT_SERVER=
# Your default squad formation UUID (first arg of SendCreateMarchMessage).
LW_DEFAULT_FORMATION=
# Optional squad-slot -> formation map: "1:<uuid>,2:<uuid>,3:<uuid>" (or bare "<uuid>,<uuid>,...").
LW_SQUAD_FORMATIONS=

# --- Where the game is on THIS machine (tools/lib/game_paths.py) ---
# Every one of these is OPTIONAL. Unset, they describe an ordinary install, which is
# what almost every machine has; they exist so that an install somewhere else — another
# drive, a re-skinned client, a portable Python — is a line here and not a code change.
#
# The one most people would ever set: the launcher, absolute.
LW_LAUNCHER=
# …or, more coarsely: the installation folder, and the publisher\product folder as it
# sits under a user's Local AppData (relative — it is what names ANOTHER account's copy).
LW_GAME_DIR=
LW_GAME_FOLDER=
# What the launcher and the client are called, and what the client titles its window.
LW_LAUNCHER_EXE=
LW_GAME_EXE=
LW_WINDOW_TITLE=
# Path to the Windows Python that has scapy + npcap (used to spawn capture helpers).
LW_WIN_PYTHON=C:\Python312\python.exe
# The client's download tree (Unity's persistentDataPath) and the chat-photo cache in it.
LW_LOCALLOW=
LW_GAME_DATA_DIR=
LW_CHAT_PHOTOS=
# Override the game's asset locations if auto-derived %LOCALAPPDATA% paths are wrong.
LW_GAMERES=
LW_ASSET_CACHE=

# --- A second client in its own Windows session (tools/rdp_instance.py) ---
# Which Windows account it runs as. NO default: it is a login on your machine, so the
# script asks rather than guessing. Its Lua daemon port defaults to the first client's
# plus one, and the RDP target to a loopback alias that is not "localhost".
LW_SECOND_USER=
LW_SECOND_DAEMON_PORT=
LW_RDP_HOST=
