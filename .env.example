# Copy this file to `.env` and fill in values. `.env` is gitignored.

# Provider selection. Independent for LLM (text-only planning)
# and Vision (screen classification / VLM calls).
# Allowed values: stub | ollama | openai_compat
#   stub          — dev mode, canned answers, no external dependencies
#   ollama        — local, via the Ollama daemon
#   openai_compat — cloud or self-hosted, via any OpenAI-compatible API
LLM_PROVIDER=stub
VISION_PROVIDER=stub

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_VISION_MODEL=qwen2-vl:2b

# --- OpenAI-compatible (cloud or self-hosted) ---
# Works with OpenAI, Groq, Together, OpenRouter, llama.cpp server, vLLM, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Account-specific defaults for the standalone tools/ scripts ---
# All optional: the live game VM is the authoritative source. These only provide a
# fixed fallback so a caller can skip the live lookup / a positional CLI arg.
# Your home/world server id (e.g. attack, gather, solo-attack default target server).
LW_DEFAULT_SERVER=
# Your default squad formation UUID (first arg of SendCreateMarchMessage).
LW_DEFAULT_FORMATION=
# Optional squad-slot -> formation map: "1:<uuid>,2:<uuid>,3:<uuid>" (or bare "<uuid>,<uuid>,...").
LW_SQUAD_FORMATIONS=

# --- Where the game is on THIS machine (tools/lib/game_paths.py) ---
# Every one of these is OPTIONAL. Unset, they describe an ordinary install, which is
# what almost every machine has; they exist so that an install somewhere else — another
# drive, a re-skinned client, a portable Python — is a line here and not a code change.
#
# The one most people would ever set: the launcher, absolute.
LW_LAUNCHER=
# …or, more coarsely: the installation folder, and the publisher\product folder as it
# sits under a user's Local AppData (relative — it is what names ANOTHER account's copy).
LW_GAME_DIR=
LW_GAME_FOLDER=
# What the launcher and the client are called, and what the client titles its window.
# LW_WINDOW_TITLE takes SEVERAL titles separated by `;` — for a machine that runs more
# than one build. Optional, and rarely needed: unset, the launcher's own manifest is
# asked what this build calls itself, and a window that answers to no known title is
# still found by the game's process (with a line in the debug log naming the title it
# had, which is what belongs here).
LW_LAUNCHER_EXE=
LW_GAME_EXE=
LW_WINDOW_TITLE=
# The launcher's own manifest — `LastWarLauncher.json`, written by the installer and
# rewritten by every update. It is what says where THIS install put its download tree
# and its bundle cache, so an update that moves either is no longer a code change.
# Optional: it is the launcher's sibling. Set it only for a layout where it is not.
LW_LAUNCHER_JSON=
# Path to the Windows Python that has scapy + npcap (used to spawn capture helpers).
LW_WIN_PYTHON=C:\Python312\python.exe
# The client's download tree (Unity's persistentDataPath) and the chat-photo cache in it.
LW_LOCALLOW=
LW_GAME_DATA_DIR=
LW_CHAT_PHOTOS=
# Where the client caches the player photos it downloads as it meets people — one
# directory per uid bucket. Optional: it sits inside the download tree above.
LW_LOCAL_IMAGES=
# Override the game's asset locations if auto-derived %LOCALAPPDATA% paths are wrong.
LW_GAMERES=
LW_ASSET_CACHE=
# The root the client keeps its downloaded bundles under. The installer offers to put
# them on another drive, and on a machine that took the offer they are nowhere near the
# install. Optional: the launcher's manifest is asked first, and only failing that is
# `<install>\Cache` assumed. LW_ASSET_CACHE (above) still overrides the cache itself.
LW_BUNDLE_ROOT=
# The game's own language tables — the BUILD directory, i.e. .../StreamingAssets/locale/<build>.
# Optional: it is found under the install by itself. Set it if the install is somewhere
# unusual, or to pin a particular build. The panel reads the game's own wording out of
# these (the «logged in on another device» message it recognises a kick by), and
# tools/game_locale.py reads them for the glossary. Unset, BOTH trees are searched —
# the install keeps the build it shipped with, and an update downloads a newer one into
# the client's own download tree — and the newest table is used per language.
LW_LOCALE_DIR=

# --- Traffic capture ---
# Where Wireshark lives, seen from WSL. The two guesses are the ordinary Windows
# install under the ordinary /mnt/c mount — set this if your machine has either
# somewhere else.
LW_WIRESHARK_DIR=
# The server port to filter a capture on. A FALLBACK: the tools ask the live
# connection first, because a capture pinned to a port the game has moved off does
# not fail — it silently records nothing, which looks like an idle game.
LW_GAME_PORT=

# --- The panel's web front-end (panel/web/, the «Веб» tab) ---
# The port it listens on. A PROFILE MAY OVERRIDE IT — a second account farmed beside the
# first wants a second port — and this is the answer for a profile that has never been
# asked. Optional: 9761 is the default, and the only reason to set it is a machine where
# that port is taken or a router that forwards a different one.
LW_WEB_PORT=

# --- What WE keep, shared by every profile (#1306) ---
# The players' faces copied out of the client's own photo cache, and the pages generated
# from the archives. Shared on purpose: the same player has the same face whichever
# account met them, so one copy serves every profile instead of four. Optional —
# `<project>/cache/` by default, git-ignored, and safe to delete whole: nothing in it is
# needed to run, and it refills itself. Set this only to put it on another disk; it grows.
LW_CACHE_DIR=

# --- A second client in its own Windows session (tools/rdp_instance.py) ---
# Which Windows account it runs as. NO default: it is a login on your machine, so the
# script asks rather than guessing. Its Lua daemon port defaults to the first client's
# plus one, and the RDP target to a loopback alias that is not "localhost".
# LW_RDP_HOST is the FIRST session profile's address; every profile after it steps one
# address up, because Windows keeps one saved RDP password per address and two accounts
# sharing an address cannot both have one. Optional — set it only where that loopback
# range is already spoken for.
LW_SECOND_USER=
LW_SECOND_DAEMON_PORT=
LW_RDP_HOST=

# --- The channel a chunk answers through (tools/lib/lua_eval.py) ---
# A chunk reports its result by logging one line, and the game's own log costs its main
# thread ~120 ms for the first line of every call — so the line goes into a private file
# beside Player.log instead, and the caller reads it there (task #1232).
# LW_ANSWER_CHANNEL=log puts every answer back in Player.log, the way it worked before.
# Optional, and only worth setting to watch a chunk's answers scroll past in the game's
# own log: a client that cannot write the file falls back to Player.log on its own.
LW_ANSWER_CHANNEL=
# The answer file itself. Optional — by default it sits beside this account's Player.log,
# which is what keeps two clients (two Windows accounts) from reading each other's.
LW_ANSWER_LOG=

# --- The wrapper a chunk must wear before the VM will parse it (tools/lib/lua_chunk_enc.py) ---
# Since the client update of 2026-08-19 the game's Lua loader decrypts every buffer
# before it parses it, so a chunk of plain source comes back as a syntax error. How the
# wrapping is done is read out of the installed plugin at start-up — nothing is pinned
# here, because the key belongs to a BUILD and the next patch may roll it.
# Both of these are optional and only worth setting for an install that keeps its parts
# somewhere unusual; LW_LUA_ENC=off sends plain source, for a build that has rolled back.
LW_XLUA_DLL=
LW_LUA_BUNDLE=
LW_LUA_ENC=
