# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# IDE
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Local config & secrets
.env
.env.local
config.local.yaml
config.local.yml

# Runtime artefacts
logs/
screenshots/
models_cache/
*.log
profiles/
panel/settings.json
# The timer and trigger catalogues are local config: the panel seeds each from its
# built-in list on first launch (panel/timers.py, panel/triggers.py) and they are
# meant to be edited on the machine they run on, so tracking either would turn every
# added timer or trigger into a diff.
panel/timers.json
panel/triggers.json

# Local artefacts: captures (may hold session tokens), decoded transcripts,
# benchmark output — never source, kept on disk but out of git.
results/
*.pcap
*.pcapng
sslkeys.log

# extracted game art (see tools/extract_hero_icons.py) → results/hero_icons/ (results/ above already covers it).

# Scanner output written outside results/ when --json is given a bare path
# (tools/scan_players.py --json players.json). Player dumps, not source.
/players.json
/result/

# tools/scratch/ — throwaway probes/one-offs from RE sessions (never source).
tools/scratch/

# Multi-instance account lists (tools/launch_as_user.py --config). They name real
# Windows accounts and MAY carry a password, so no real one belongs in git — only
# tools/data/accounts.example.json is tracked.
/accounts.json
accounts*.json
!tools/data/accounts.example.json
